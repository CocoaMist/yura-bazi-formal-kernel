{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yuracore.birth_compilation.schema.v1",
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "BirthCompilationInputV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "subjectRef", "birth", "clockPolicies", "precisionPolicy", "activeProfileId"],
      "properties": {
        "version": { "const": "yuracore.birth_compilation_input.v1" },
        "subjectRef": { "type": "string", "minLength": 1 },
        "birth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calendar", "timeZoneId", "input", "location", "traditionalSexClass"],
          "properties": {
            "calendar": { "enum": ["gregorian", "lunar"] },
            "timeZoneId": { "type": "string", "minLength": 1 },
            "input": { "type": "object" },
            "location": {
              "type": "object",
              "additionalProperties": false,
              "required": ["longitude", "latitude", "label"],
              "properties": {
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "label": { "type": "string", "minLength": 1 }
              }
            },
            "traditionalSexClass": { "enum": ["male", "female", "unknown"] }
          }
        },
        "clockPolicies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["civil", "true_solar"] }
        },
        "precisionPolicy": { "type": "object" },
        "activeProfileId": { "type": "string", "minLength": 1 }
      }
    },
    "BirthCompilationBundleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "input", "inputFactHash", "release", "calendar", "compilation", "bundleHash"],
      "properties": {
        "version": { "const": "yuracore.birth_compilation_bundle.v1" },
        "input": { "$ref": "#/$defs/BirthCompilationInputV1" },
        "inputFactHash": { "$ref": "#/$defs/Sha256" },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseManifestHash", "engineVersion", "activeProfileId"],
          "properties": {
            "releaseManifestHash": { "$ref": "#/$defs/Sha256" },
            "engineVersion": { "type": "string", "minLength": 1 },
            "activeProfileId": { "type": "string", "minLength": 1 }
          }
        },
        "calendar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolutionEnvelope", "decisionTrace", "candidateSnapshotSet"],
          "properties": {
            "resolutionEnvelope": { "$ref": "natal-compilation.schema.json#/$defs/CalendarResolutionEnvelopeV1" },
            "decisionTrace": { "$ref": "natal-compilation.schema.json#/$defs/NatalCalendarDecisionTraceV1" },
            "candidateSnapshotSet": { "$ref": "natal-compilation.schema.json#/$defs/CandidateSnapshotSetV2" }
          }
        },
        "compilation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "batch"],
          "properties": {
            "request": { "$ref": "natal-compilation.schema.json#/$defs/NatalCompilationRequestV1" },
            "batch": { "$ref": "natal-compilation.schema.json#/$defs/NatalCompilationBatchV2" }
          }
        },
        "bundleHash": { "$ref": "#/$defs/Sha256" }
      }
    },
    "BirthCompilationErrorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "errorCode", "message"],
      "properties": {
        "version": { "const": "yuracore.birth_compilation_error.v1" },
        "status": { "const": "failed" },
        "errorCode": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "BirthCompilerOutputV1": {
      "oneOf": [
        { "$ref": "natal-fixed.schema.json#/$defs/NatalFixedBundleV1" },
        { "$ref": "#/$defs/BirthCompilationBundleV1" },
        { "$ref": "#/$defs/BirthCompilationErrorV1" }
      ]
    }
  }
}
